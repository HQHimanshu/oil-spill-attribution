*.py[cod]
*$py.class
*.pyd
*.so
*.dll

# Pytest & Coverage
.pytest_cache/
.coverage
htmlcov/

# Type Checker & Linters
.mypy_cache/
.ruff_cache/

# Environment Variables & Secrets
.env
.env.*
!.env.example

# IDE / Editor Files
.vscode/
.idea/
*.swp
*.swo

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Logs & Runtime Dumps
*.log
logs/
