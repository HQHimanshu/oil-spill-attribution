# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# Build & Packaging
build/
dist/
*.egg-info/
wheels/
*.whl

# Runtime Network Cache (Auto-generated by Open-Meteo queries)
backend/database/environmental_cache/

